    "groups": [
      {
        "title": "Web server",
        "note": "Restart TweetNook after changing these.",
        "fields": [
          "web.host",
          "web.port"
        ]
      },
      {
        "title": "Avatars",
        "fields": [
          "web.fetch_avatars",
          "web.avatar_cache_limit_enabled",
          "web.avatar_cache_limit_mb"
        ]
      },
      {
        "title": "Analytics",
        "fields": [
          "web.analytics_refresh_time"
        ]
      },
      {
        "title": "Sync speed",
        "note": "The defaults are tuned to stay under X's rate limits. Change them only if syncs fail or run too slowly.",
        "fields": [
          "sync.page_delay",
          "sync.detail_delay",
          "sync.timeout"
        ]
      },
      {
        "title": "Rate limits",
        "fields": [
          "sync.max_retries",
          "sync.backoff_base",
          "sync.detail_max_retries",
          "sync.detail_backoff_base",
          "sync.cooldown_threshold",
          "sync.cooldown_duration"
        ]
      },
      {
        "title": "Quoted and linked posts",
        "fields": [
          "sync.max_linked_depth",
          "sync.reply_linked_depth"
        ]
      },
      {
        "title": "Database",
        "note": "Memory the local database may use. Larger values can speed up big archives.",
        "fields": [
          "database.cache_size_kb",
          "database.mmap_size_bytes"
        ]
      }
    ],
    "units": {
      "web.avatar_cache_limit_mb": "MiB",
      "sync.page_delay": "sec",
      "sync.detail_delay": "sec",
      "sync.timeout": "sec",
      "sync.backoff_base": "sec",
      "sync.detail_backoff_base": "sec",
      "sync.cooldown_threshold": "errors",
      "sync.cooldown_duration": "sec",
      "sync.max_linked_depth": "hops",
      "database.cache_size_kb": "KiB",
      "database.mmap_size_bytes": "bytes"
    },
    "byte_units": {
      "database.cache_size_kb": 1024,
      "database.mmap_size_bytes": 1
    },
    "controls": {
      "web.analytics_refresh_time": "time",
      "sync.reply_linked_depth": "switch"
    },
    "requires": {
      "web.avatar_cache_limit_enabled": [
        "web.fetch_avatars"
      ],
      "web.avatar_cache_limit_mb": [
        "web.fetch_avatars",
        "web.avatar_cache_limit_enabled"
      ]
    },
